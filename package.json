{
  "name": "agenda-obra-bot",
  "version": "1.0.0",
  "description": "WhatsApp Bot para gestão e agendamento de obras com Baileys, Supabase e Gemini",
  "main": "dist/bot.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/bot.js",
    "start:setup": "ts-node src/setup.ts",
    "dev:bot": "tsx watch src/bot.ts",
    "dev:setup": "tsx watch src/setup.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@supabase/supabase-js": "^2.49.1",
    "@whiskeysockets/baileys": "^6.7.24",
    "dotenv": "^16.4.7",
    "express": "^4.22.3",
    "google-tts-api": "^2.0.2",
    "node-cron": "^3.0.3",
    "node-html-to-image": "^5.0.0",
    "pino": "^9.6.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/node-cron": "^3.0.11",
    "@types/qrcode": "^1.5.6",
    "@types/qrcode-terminal": "^0.12.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
